<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Steering keys: one row per steering wheel button, with its learned key code, its action and Learn -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/SettingsPage">

    <TextView
        style="@style/SettingsHeader"
        android:text="@string/keymap_settings_section" />

    <TextView
        android:id="@+id/keymap_hint"
        style="@style/SettingsSummary"
        android:layout_marginBottom="8dp"
        android:layout_marginTop="0dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:text="@string/keymap_settings_hint" />

    <LinearLayout style="@style/SettingsSection">
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsLabelBox">
                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/keymap_settings_btnleft" />
                <TextView
                    android:id="@+id/keycode_left_value"
                    style="@style/SettingsSummary" />
            </LinearLayout>
            <Spinner
                android:id="@+id/btn_left"
                style="@style/SettingsChoice"
                android:layout_marginRight="12dp" />
            <Button
                android:id="@+id/keycode_left"
                style="@style/SettingsButton"
                android:minWidth="96dp"
                android:text="@string/keymap_settings_learn" />
        </LinearLayout>
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsLabelBox">
                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/keymap_settings_btnright" />
                <TextView
                    android:id="@+id/keycode_right_value"
                    style="@style/SettingsSummary" />
            </LinearLayout>
            <Spinner
                android:id="@+id/btn_right"
                style="@style/SettingsChoice"
                android:layout_marginRight="12dp" />
            <Button
                android:id="@+id/keycode_right"
                style="@style/SettingsButton"
                android:minWidth="96dp"
                android:text="@string/keymap_settings_learn" />
        </LinearLayout>
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsLabelBox">
                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/keymap_settings_btnsource" />
                <TextView
                    android:id="@+id/keycode_source_value"
                    style="@style/SettingsSummary" />
            </LinearLayout>
            <Spinner
                android:id="@+id/btn_source"
                style="@style/SettingsChoice"
                android:layout_marginRight="12dp" />
            <Button
                android:id="@+id/keycode_source"
                style="@style/SettingsButton"
                android:minWidth="96dp"
                android:text="@string/keymap_settings_learn" />
        </LinearLayout>
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsLabelBox">
                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/keymap_settings_btnplus" />
                <TextView
                    android:id="@+id/keycode_plus_value"
                    style="@style/SettingsSummary" />
            </LinearLayout>
            <Spinner
                android:id="@+id/btn_plus"
                style="@style/SettingsChoice"
                android:layout_marginRight="12dp"
                android:alpha="0.5"
                android:clickable="false"
                android:enabled="false" />
            <Button
                android:id="@+id/keycode_plus"
                style="@style/SettingsButton"
                android:minWidth="96dp"
                android:text="@string/keymap_settings_learn" />
        </LinearLayout>
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsLabelBox">
                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/keymap_settings_btnminus" />
                <TextView
                    android:id="@+id/keycode_min_value"
                    style="@style/SettingsSummary" />
            </LinearLayout>
            <Spinner
                android:id="@+id/btn_minus"
                style="@style/SettingsChoice"
                android:layout_marginRight="12dp"
                android:alpha="0.5"
                android:clickable="false"
                android:enabled="false" />
            <Button
                android:id="@+id/keycode_min"
                style="@style/SettingsButton"
                android:minWidth="96dp"
                android:text="@string/keymap_settings_learn" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
