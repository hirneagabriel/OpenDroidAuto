<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Car -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/SettingsPage">

    <TextView
        style="@style/SettingsHeader"
        android:text="@string/settings_section_driving" />

    <LinearLayout style="@style/SettingsSection">
        <CheckBox
            android:id="@+id/left_drive"
            style="@style/SettingsToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/car_settings_left_drive" />
        <CheckBox
            android:id="@+id/hide_clock"
            style="@style/SettingsToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/car_settings_hide_clock" />
        <CheckBox
            android:id="@+id/play_media_during_vr"
            style="@style/SettingsToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/car_settings_play_media_during_vr" />
    </LinearLayout>

    <TextView
        style="@style/SettingsHeader"
        android:text="@string/settings_section_integration" />

    <LinearLayout style="@style/SettingsSection">
        <LinearLayout
            style="@style/SettingsRow"
            android:background="@drawable/row_bg"
            android:clickable="true"
            android:tag="toggle_row">
            <LinearLayout style="@style/SettingsLabelBox">
                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/advanced_settings_enablehondaintegration" />
                <TextView
                    style="@style/SettingsSummary"
                    android:text="@string/advanced_settings_enablehondaintegration_summary" />
            </LinearLayout>
            <CheckBox
                android:id="@+id/enable_hondaintegration"
                style="@style/SettingsSwitch" />
        </LinearLayout>
        <CheckBox
            android:id="@+id/enable_hondamicvr"
            style="@style/SettingsToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/advanced_settings_enablehondamicvr" />
    </LinearLayout>

    <TextView
        style="@style/SettingsHeader"
        android:text="@string/settings_section_steering" />

    <LinearLayout style="@style/SettingsSection">
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsLabelBox">
                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/advanced_settings_swmode" />
            </LinearLayout>
            <Spinner
                android:id="@+id/sw_mode"
                style="@style/SettingsChoice" />
        </LinearLayout>
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsLabelBox">
                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/advanced_settings_steeringWheelIdx" />
                <TextView
                    style="@style/SettingsSummary"
                    android:text="@string/advanced_settings_steeringWheelIdx_summary" />
            </LinearLayout>
            <EditText
                android:id="@+id/steeringwheel_idx"
                style="@style/SettingsField"
                android:inputType="number" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/SettingsHeader"
        android:text="@string/settings_section_audio" />

    <LinearLayout style="@style/SettingsSection">
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsLabelBox">
                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/advanced_settings_modeMgrAudioIdx" />
                <TextView
                    style="@style/SettingsSummary"
                    android:text="@string/advanced_settings_modeMgrAudioIdx_summary" />
            </LinearLayout>
            <EditText
                android:id="@+id/modemgraudio_idx"
                style="@style/SettingsField"
                android:inputType="number" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
