<?xml version="1.0" encoding="utf-8"?>
<!-- home screen tile in the car's own style: textured tile, the logo as a large motif cropped off the lower left
     (like the NAV compass), and a big bold label on the right -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_connection"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">

    <ImageView
        android:id="@+id/widget_connection_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_tile_idle" />

    <ImageView
        android:id="@+id/widget_connection_logo"
        android:layout_width="150dp"
        android:layout_height="130dp"
        android:layout_gravity="bottom|left"
        android:layout_marginBottom="-34dp"
        android:layout_marginLeft="-48dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_motif" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|right"
        android:gravity="right"
        android:orientation="vertical"
        android:paddingRight="10dp">

        <TextView
            android:id="@+id/widget_connection_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:lineSpacingMultiplier="0.9"
            android:shadowColor="#C0000000"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:text="@string/widget_connection_label"
            android:textColor="#FFFFFFFF"
            android:textSize="24dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_connection_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="right"
            android:maxWidth="110dp"
            android:shadowColor="#C0000000"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:singleLine="true"
            android:text="@string/widget_connection_no_phone"
            android:textColor="#FFD0D4D8"
            android:textSize="12dp" />
    </LinearLayout>
</FrameLayout>
