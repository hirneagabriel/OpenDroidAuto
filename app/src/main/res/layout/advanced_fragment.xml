<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Developer -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/SettingsPage">

    <TextView
        style="@style/SettingsHeader"
        android:text="@string/settings_section_logging" />

    <LinearLayout style="@style/SettingsSection">
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsLabelBox">
                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/advanced_settings_logLevel" />
            </LinearLayout>
            <Spinner
                android:id="@+id/loglevel"
                style="@style/SettingsChoice" />
        </LinearLayout>
        <LinearLayout
            style="@style/SettingsRow"
            android:background="@drawable/row_bg"
            android:clickable="true"
            android:tag="toggle_row">
            <LinearLayout style="@style/SettingsLabelBox">
                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/advanced_settings_logProtocol" />
                <TextView
                    style="@style/SettingsSummary"
                    android:text="@string/advanced_settings_logProtocol_summary" />
            </LinearLayout>
            <CheckBox
                android:id="@+id/logProtocol"
                style="@style/SettingsSwitch" />
        </LinearLayout>
        <CheckBox
            android:id="@+id/enable_debug"
            style="@style/SettingsToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/advanced_settings_enabledebug" />
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsLabelBox">
                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/advanced_settings_logDir" />
            </LinearLayout>
            <EditText
                android:id="@+id/log_dir"
                style="@style/SettingsField"
                android:inputType="text" />
        </LinearLayout>
        <LinearLayout
            style="@style/SettingsRow"
            android:background="@drawable/row_bg"
            android:clickable="true"
            android:tag="toggle_row">
            <LinearLayout style="@style/SettingsLabelBox">
                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/advanced_settings_resource_monitor" />
                <TextView
                    style="@style/SettingsSummary"
                    android:text="@string/advanced_settings_resource_monitor_summary" />
            </LinearLayout>
            <CheckBox
                android:id="@+id/resource_monitor"
                style="@style/SettingsSwitch" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/SettingsHeader"
        android:text="@string/settings_section_identity" />

    <LinearLayout style="@style/SettingsSection">
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsLabelBox">
                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/car_settings_hu_name" />
                <TextView
                    style="@style/SettingsSummary"
                    android:text="@string/settings_section_identity_summary" />
            </LinearLayout>
            <EditText
                android:id="@+id/hu_name"
                style="@style/SettingsField"
                android:inputType="text" />
        </LinearLayout>
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsLabelBox">
                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/car_settings_model" />
            </LinearLayout>
            <EditText
                android:id="@+id/car_model"
                style="@style/SettingsField"
                android:inputType="text" />
        </LinearLayout>
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsLabelBox">
                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/car_settings_year" />
            </LinearLayout>
            <EditText
                android:id="@+id/car_year"
                style="@style/SettingsField"
                android:inputType="number" />
        </LinearLayout>
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsLabelBox">
                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/car_settings_hu_make" />
            </LinearLayout>
            <EditText
                android:id="@+id/hu_make"
                style="@style/SettingsField"
                android:inputType="text" />
        </LinearLayout>
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsLabelBox">
                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/car_settings_hu_model" />
            </LinearLayout>
            <EditText
                android:id="@+id/hu_model"
                style="@style/SettingsField"
                android:inputType="text" />
        </LinearLayout>
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsLabelBox">
                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/car_settings_sw_build" />
            </LinearLayout>
            <EditText
                android:id="@+id/sw_build"
                style="@style/SettingsField"
                android:inputType="text" />
        </LinearLayout>
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsLabelBox">
                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/car_settings_sw_version" />
            </LinearLayout>
            <EditText
                android:id="@+id/sw_version"
                style="@style/SettingsField"
                android:inputType="text" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/SettingsHeader"
        android:text="@string/settings_section_performance" />

    <LinearLayout style="@style/SettingsSection">
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsLabelBox">
                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/advanced_settings_threads" />
                <TextView
                    style="@style/SettingsSummary"
                    android:text="@string/advanced_settings_threads_summary" />
            </LinearLayout>
            <EditText
                android:id="@+id/num_threads"
                style="@style/SettingsField"
                android:inputType="number" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
