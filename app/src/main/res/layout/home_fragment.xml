<?xml version="1.0" encoding="utf-8"?>
<!-- Home: colour-coded tiles over the car's wallpaper, like the head unit's own home screen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wallpaper_scrim"
    android:orientation="vertical">

    <include layout="@layout/title_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="11dp">

        <!-- Android Auto: grey until a phone is ready -->
        <FrameLayout
            android:id="@+id/aaTile"
            style="@style/Tile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="5"
            android:background="@drawable/tile_idle">

            <ImageView
                android:id="@+id/aaLogo"
                android:layout_width="150dp"
                android:layout_height="130dp"
                android:layout_gravity="center"
                android:layout_marginBottom="40dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/logo" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingBottom="12dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp">

                <TextView
                    style="@style/TileText"
                    android:text="@string/home_aa_title"
                    android:textSize="40dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/aaStatus"
                    style="@style/TileText"
                    android:text="@string/home_aa_no_phone"
                    android:textColor="@color/oda_text_dim"
                    android:textSize="19dp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <!-- tap to pick another USB device -->
                <FrameLayout
                    android:id="@+id/usbTile"
                    style="@style/Tile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/tile_glass">

                    <ImageView
                        android:id="@+id/usbIcon"
                        style="@style/TileIcon"
                        android:src="@drawable/usb"
                        android:tint="@color/oda_tint_usb" />

                    <TextView
                        android:id="@+id/txtUsbIcon"
                        style="@style/TileLabel"
                        android:text="@string/home_usb" />

                    <View
                        style="@style/TileEdge"
                        android:background="@color/oda_tint_usb" />
                </FrameLayout>

                <!-- debug only (Advanced settings): start over Wi-Fi -->
                <FrameLayout
                    android:id="@+id/wifiTile"
                    style="@style/Tile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/tile_glass">

                    <ImageView
                        android:id="@+id/wifiIcon"
                        style="@style/TileIcon"
                        android:src="@drawable/wifi"
                        android:tint="@color/oda_tint_wifi" />

                    <TextView
                        android:id="@+id/txtWifiIcon"
                        style="@style/TileLabel"
                        android:text="@string/home_wifi" />

                    <View
                        style="@style/TileEdge"
                        android:background="@color/oda_tint_wifi" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/settingsTile"
                    style="@style/Tile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/tile_glass">

                    <ImageView
                        style="@style/TileIcon"
                        android:src="@drawable/advanced_settings"
                        android:tint="@color/oda_tint_settings" />

                    <TextView
                        style="@style/TileLabel"
                        android:text="@string/settings" />

                    <View
                        style="@style/TileEdge"
                        android:background="@color/oda_tint_settings" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/exitTile"
                    style="@style/Tile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/tile_glass">

                    <ImageView
                        style="@style/TileIcon"
                        android:src="@drawable/ic_power"
                        android:tint="@color/oda_text_dim" />

                    <TextView
                        style="@style/TileLabel"
                        android:text="@string/exit" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
