<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Display -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/SettingsPage">

    <TextView
        style="@style/SettingsHeader"
        android:text="@string/settings_section_picture" />

    <LinearLayout style="@style/SettingsSection">
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsLabelBox">
                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/video_settings_resolution" />
            </LinearLayout>
            <Spinner
                android:id="@+id/video_resolution"
                style="@style/SettingsChoice" />
        </LinearLayout>
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsLabelBox">
                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/video_settings_fps" />
            </LinearLayout>
            <Spinner
                android:id="@+id/video_fps"
                style="@style/SettingsChoice" />
        </LinearLayout>
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsLabelBox">
                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/video_settings_dpi" />
                <TextView
                    style="@style/SettingsSummary"
                    android:text="@string/video_settings_dpi_summary" />
            </LinearLayout>
            <EditText
                android:id="@+id/video_dpi"
                style="@style/SettingsField"
                android:inputType="number" />
        </LinearLayout>
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsLabelBox">
                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/video_settings_margin" />
                <TextView
                    style="@style/SettingsSummary"
                    android:text="@string/video_settings_margin_summary" />
            </LinearLayout>
            <EditText
                android:id="@+id/video_margin"
                style="@style/SettingsField"
                android:inputType="text" />
        </LinearLayout>
        <LinearLayout
            style="@style/SettingsRow"
            android:background="@drawable/row_bg"
            android:clickable="true"
            android:tag="toggle_row">
            <LinearLayout style="@style/SettingsLabelBox">
                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/video_settings_decoder_low_latency" />
                <TextView
                    style="@style/SettingsSummary"
                    android:text="@string/video_settings_decoder_low_latency_summary" />
            </LinearLayout>
            <CheckBox
                android:id="@+id/video_decoder_low_latency"
                style="@style/SettingsSwitch" />
        </LinearLayout>
        <LinearLayout
            style="@style/SettingsRow"
            android:background="@drawable/row_bg"
            android:clickable="true"
            android:tag="toggle_row">
            <LinearLayout style="@style/SettingsLabelBox">
                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/video_settings_decoder_release_early" />
                <TextView
                    style="@style/SettingsSummary"
                    android:text="@string/video_settings_decoder_release_early_summary" />
            </LinearLayout>
            <CheckBox
                android:id="@+id/video_decoder_release_early"
                style="@style/SettingsSwitch" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/SettingsHeader"
        android:text="@string/settings_section_daynight" />

    <LinearLayout style="@style/SettingsSection">
        <LinearLayout style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsLabelBox">
                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/video_settings_nightmode" />
                <TextView
                    style="@style/SettingsSummary"
                    android:text="@string/video_settings_nightmode_summary" />
            </LinearLayout>
            <Spinner
                android:id="@+id/video_night_mode"
                style="@style/SettingsChoice" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/SettingsHeader"
        android:text="@string/settings_section_background" />

    <LinearLayout style="@style/SettingsSection">
        <CheckBox
            android:id="@+id/showMediaNotification"
            style="@style/SettingsToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/video_show_media_notification" />
        <CheckBox
            android:id="@+id/showNavigationNotification"
            style="@style/SettingsToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/video_show_navigation_notification" />
        <LinearLayout
            style="@style/SettingsRow"
            android:background="@drawable/row_bg"
            android:clickable="true"
            android:tag="toggle_row">
            <LinearLayout style="@style/SettingsLabelBox">
                <TextView
                    style="@style/SettingsLabel"
                    android:text="@string/video_show_app_badge" />
                <TextView
                    style="@style/SettingsSummary"
                    android:text="@string/video_show_app_badge_summary" />
            </LinearLayout>
            <CheckBox
                android:id="@+id/showAppBadge"
                style="@style/SettingsSwitch" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
