<?xml version="1.0" encoding="utf-8"?>
<!-- secondary home tiles: quiet dark glass so the Android Auto tile stands out -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#D0121820"
        android:startColor="#D0232C36" />
    <stroke
        android:width="1dp"
        android:color="#38FFFFFF" />
    <corners android:radius="2dp" />
</shape>
