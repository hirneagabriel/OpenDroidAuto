<?xml version="1.0" encoding="utf-8"?>
<!-- ON/OFF switch, off: dark track, knob on the left -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="56dp" android:height="30dp" />
            <solid android:color="#FF2A3038" />
            <stroke android:width="1dp" android:color="#50FFFFFF" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item android:bottom="4dp" android:left="4dp" android:right="30dp" android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="#FF9AA4B0" />
        </shape>
    </item>
</layer-list>
