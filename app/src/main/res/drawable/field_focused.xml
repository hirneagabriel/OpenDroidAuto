<?xml version="1.0" encoding="utf-8"?>
<!-- settings text value while editing: blue underline on a faint highlight -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="-2dp"
        android:right="-2dp"
        android:top="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="#1FFFFFFF" />
            <stroke android:width="2dp" android:color="@color/oda_accent" />
            <padding android:left="6dp" android:right="6dp" />
        </shape>
    </item>
</layer-list>
