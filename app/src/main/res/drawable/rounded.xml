<?xml version="1.0" encoding="utf-8"?>
<!-- popups (start, media, navigation): dark glass with a blue edge -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#EE14181E" />

    <stroke
        android:width="2dp"
        android:color="@color/oda_accent" />

    <padding
        android:bottom="5dp"
        android:left="5dp"
        android:right="5dp"
        android:top="5dp" />

    <corners android:radius="4dp" />

</shape>
