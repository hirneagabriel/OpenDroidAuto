<?xml version="1.0" encoding="utf-8"?>
<!-- ON/OFF switch, on: blue track, knob on the right -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="56dp" android:height="30dp" />
            <solid android:color="@color/oda_accent" />
            <stroke android:width="1dp" android:color="#80FFFFFF" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item android:bottom="4dp" android:left="30dp" android:right="4dp" android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</layer-list>
