<?xml version="1.0" encoding="utf-8"?>
<!-- home screen tile with no phone: dim, see-through grey -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#B0202020"
        android:startColor="#B0505050" />
